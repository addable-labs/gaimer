{
    "productName": "gaimer",
    "version": "0.1.0",
    "identifier": "com.gaimer.desktop",
    "build": {
        "beforeDevCommand": "yarn dev",
        "devUrl": "http://localhost:1430",
        "beforeBuildCommand": "yarn build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "gaimer",
                "fullscreen": false,
                "resizable": true,
                "width": 1024,
                "height": 768
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.openai.com https://api.anthropic.com; frame-src 'self' blob:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "iOS": {
            "minimumSystemVersion": "15.0"
        }
    }
}
