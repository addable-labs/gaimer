{
    "$schema": "",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        {
            "identifier": "shell:allow-spawn",
            "allow": [
                {
                    "name": "shell-cmd",
                    "cmd": "/bin/zsh",
                    "args": [
                        "-l",
                        "-c",
                        {
                            "validator": "(?:claude --version|claude auth status|claude -p --model [a-z0-9][a-z0-9.-]* --tools \"\" --system-prompt-file '[^']*/gaimer-system-[0-9]+\\.txt' --no-session-persistence --safe-mode --strict-mcp-config --output-format json < '[^']*/gaimer-prompt-[0-9]+\\.txt')"
                        }
                    ]
                },
                {
                    "name": "open-app",
                    "cmd": "open",
                    "args": ["-a", "Terminal"]
                }
            ]
        },
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                {
                    "url": "https://*"
                }
            ]
        },
        "fs:default",
        "fs:allow-temp-write",
        "fs:allow-temp-read",
        "fs:allow-temp-meta",
        "fs:allow-mkdir",
        "fs:allow-read-file",
        "fs:allow-write-file",
        "fs:allow-read-dir",
        "fs:allow-remove",
        "fs:allow-exists",
        {
            "identifier": "fs:scope",
            "allow": [
                "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Gaimer",
                "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Gaimer/**"
            ]
        },
        "stronghold:default"
    ]
}
