{
    "$schema": "",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "shell:allow-open",
        "fs:default",
        "http:default",
        "stronghold:default",
        {
            "identifier": "http:default",
            "allow": [
                {
                    "url": "https://api.openai.com/*"
                },
                {
                    "url": "https://api.anthropic.com/*"
                }
            ]
        }
    ]
}
